PORT=4000
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
CORS_ORIGINS=http://localhost:5173,https://your-vercel-app.vercel.app
CORS_ORIGIN_SUFFIXES=vercel.app
# Use autonomous-fake to run the new deterministic autonomous harness.
AGENT_RUNTIME=legacy

# Server-only Astra credentials for /survival. Without a key the island stays paused.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Total paid decision attempts for the saved island; raise to resume a capped run.
SURVIVAL_DECISION_LIMIT=120
